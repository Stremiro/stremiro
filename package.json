{
  "name": "stremiro",
  "private": true,
  "version": "0.5.1-alpha",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "@tauri-apps/api": "^2.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "tauri:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-tauri.ps1",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-tauri.ps1",
    "tauri:build:unsigned": "powershell -ExecutionPolicy Bypass -File ./scripts/build-tauri.ps1 -Unsigned",
    "tauri:build:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-tauri.ps1 -Clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run release:version:check && bun run fmt:rust && bun run clippy",
    "release:version:check": "bun ./scripts/release-version.mjs check",
    "release:version:set": "bun ./scripts/release-version.mjs set",
    "release:manifest": "bun ./scripts/release-github.mjs manifest",
    "release:publish": "bun ./scripts/release-github.mjs publish",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tauri-plugin-libmpv-api": "^0.3.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
